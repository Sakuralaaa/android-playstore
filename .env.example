# DroidCloud 环境变量示例（复制为 .env 后修改）

# Web 控制台登录密码（必填，建议 12 位以上强密码）
ACCESS_PASSWORD=your-strong-password-here

# Web 服务端口（默认 6080，Atoll 反代指向此端口即可）
PORT=6080

# Android 版本：14 / 15 / 16（默认 16，自带正版 Google Play 商店）
ANDROID_VERSION=16

# 模拟器硬件配额（根据宿主机资源调整）
RAM_MB=4096
CORES=4
DATA_SIZE=16G

# 屏幕渲染分辨率档位：
#   smooth   = 540x1200@240dpi（无物理 GPU 时极致流畅）
#   balanced = 720x1600@320dpi（默认，清晰度与速度最佳平衡）
#   hd       = 1080x2400@420dpi（原像素，CPU 占用较高）
SCREEN_PRESET=balanced

# 默认视频推流画质：smooth | balanced | ultra（网页内可实时切换）
STREAM_PRESET=balanced

# 语言与时区
LANG_LOCALE=zh-CN
TZ=Asia/Shanghai

# DNS 服务器
DNS_SERVERS=8.8.8.8,1.1.1.1

# 可选：为模拟器配置 HTTP 代理以访问 Google 服务
# HTTP_PROXY_URL=http://127.0.0.1:7890
